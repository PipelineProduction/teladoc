<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited List View for mailing.contact -->
    <record id="mailing_contact_view_tree_inherit_vhealth" model="ir.ui.view">
        <field name="name">mailing.contact.view.list.inherit.vhealth</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="x_studio_vhealth_contact" optional="show"/>
                <field name="x_studio_aetna_member_status" optional="show"/>
                <field name="x_studio_cohort_group" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherited Form View for mailing.contact matching Odoo Online Studio structure -->
    <record id="mailing_contact_view_form_inherit_vhealth" model="ir.ui.view">
        <field name="name">mailing.contact.view.form.inherit.vhealth</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="/form//field[@name='tag_ids']" position="after">
                    <field name="x_studio_aetna_member_status"/>
                </xpath>
                <xpath expr="/form/sheet/group/group[2]/field[@name='create_date']" position="after">
                    <field name="x_studio_vhealth_contact"/>
                </xpath>
                <xpath expr="/form/sheet/notebook/page" position="after">
                    <page string="Email marketing" name="studio_page_78d_1k07lgra7">
                        <group name="studio_group_78d">
                            <group name="studio_group_78d_left">
                                <field name="x_studio_first_name"/>
                                <field name="x_studio_last_name"/>
                            </group>
                            <group name="studio_group_78d_right">
                                <field name="x_studio_cohort_group"/>
                                <field name="x_studio_aetna_language"/>
                            </group>
                        </group>
                        <group name="studio_group_tj_1k0a6p200" string="Member data">
                            <group name="studio_group_tj_left">
                                <field name="x_studio_aetna_access_code"/>
                                <field name="x_studio_member_effective_date" force_save="1" readonly="True"/>
                                <field name="x_studio_products_2" widget="many2many_checkboxes"/>
                                <field name="x_studio_sub_client"/>
                            </group>
                            <group name="studio_group_tj_right">
                                <field name="x_studio_aetna_id"/>
                                <field name="x_studio_launch_date" force_save="1" readonly="True" options="{&quot;numeric&quot;:true}"/>
                                <field name="x_studio_member_id"/>
                                <field name="x_studio_registration_date" force_save="0" readonly="False" options="{&quot;numeric&quot;:true}"/>
                                <field name="x_studio_sub_group"/>
                            </group>
                        </group>
                        <group name="studio_group_3qs_1k0a9pu3r" string="Aetna">
                            <group name="studio_group_3qs_left">
                                <field name="x_studio_1st_email_non_email"/>
                                <field name="x_studio_aetna_status_live"/>
                                <field name="x_studio_app_unique_registered"/>
                                <field name="x_studio_client"/>
                                <field name="x_studio_do_you_have_children"/>
                                <field name="x_studio_dob" required="False" force_save="1" readonly="True"/>
                                <field name="x_studio_gender"/>
                                <field name="x_studio_is_group_talent_trust"/>
                                <field name="x_studio_nationality"/>
                                <field name="x_studio_send_launch_sms"/>
                                <field name="x_studio_sms_launch_no"/>
                                <field name="x_studio_status" force_save="1" readonly="True"/>
                                <field name="x_studio_vhealth90"/>
                                <field name="x_studio_aetna_consultation"/>
                                <field name="x_studio_aetna_consultation_video"/>
                            </group>
                            <group name="studio_group_3qs_right">
                                <field name="x_studio_aetna_email_template" widget="radio" force_save="1" readonly="True"/>
                                <field name="x_studio_app_registered"/>
                                <field name="x_studio_are_you_registered_with_vhealth_by_aetna"/>
                                <field name="x_studio_created_date_import"/>
                                <field name="x_studio_family_status"/>
                                <field name="x_studio_invalid_phone_number"/>
                                <field name="x_studio_member_type"/>
                                <field name="x_studio_not_registered_anymore" force_save="1" readonly="True"/>
                                <field name="x_studio_sms_stop_opted_out"/>
                                <field name="x_studio_sms_status_report" force_save="1" readonly="True"/>
                                <field name="x_studio_what_is_your_marital_status"/>
                                <field name="x_studio_aetna_consultation_call_back"/>
                            </group>
                        </group>
                        <group name="studio_group_3hd_1k0adl6v9" string="Aetna Dependent">
                            <group name="studio_group_3hd_left">
                                <field name="x_studio_dependent_email" force_save="1" readonly="True"/>
                                <field name="x_studio_dependent_mobile_number" force_save="1" readonly="True"/>
                                <field name="x_studio_family_member_explicit_consent_1" widget="radio" force_save="1" readonly="True"/>
                            </group>
                            <group name="studio_group_3hd_right">
                                <field name="x_studio_dependent_first_name" force_save="1" readonly="True"/>
                                <field name="x_studio_family_invite_form_url"/>
                                <field name="x_studio_is_dependent_from_invite_form"/>
                                <field name="x_studio_primary_member_first_name"/>
                            </group>
                        </group>
                        <group name="studio_group_1tp_1k0cl6teg" string="Uncategorized">
                            <group name="studio_group_1tp_left">
                                <field name="x_studio_check_for_engagement"/>
                                <field name="x_studio_registered_manual_action"/>
                            </group>
                            <group name="studio_group_1tp_right">
                                <field name="x_studio_location_us_or_canada"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
