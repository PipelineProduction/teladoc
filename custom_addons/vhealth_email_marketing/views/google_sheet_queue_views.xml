<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_sheet_queue_list" model="ir.ui.view">
        <field name="name">x.google.sheet.registration.list</field>
        <field name="model">x_google_sheet_registr</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_process_queue" type="object" string="Send Pending to Google Sheets" class="oe_highlight"/>
                </header>
                <field name="x_studio_email"/>
                <field name="x_studio_registration_date"/>
                <field name="x_studio_prefix_phone"/>
                <field name="x_studio_access_code"/>
                <field name="x_studio_sent" widget="boolean_toggle"/>
                <field name="retry_count"/>
                <field name="last_error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_google_sheet_queue_form" model="ir.ui.view">
        <field name="name">x.google.sheet.registration.form</field>
        <field name="model">x_google_sheet_registr</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_now" type="object" string="Send to Google Sheets" class="oe_highlight" invisible="x_studio_sent"/>
                    <button name="action_send_now" type="object" string="Re-send to Google Sheets" invisible="not x_studio_sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_studio_email"/>
                            <field name="x_studio_registration_date"/>
                            <field name="x_studio_prefix_phone"/>
                        </group>
                        <group>
                            <field name="x_studio_access_code"/>
                            <field name="x_studio_sent" widget="boolean_toggle"/>
                            <field name="retry_count"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_sheet_queue" model="ir.actions.act_window">
        <field name="name">Google Sheet Registration Queue</field>
        <field name="res_model">x_google_sheet_registr</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_server_send_google_sheet_queue" model="ir.actions.server">
        <field name="name">Send to Google Sheets</field>
        <field name="model_id" ref="model_x_google_sheet_registr"/>
        <field name="binding_model_id" ref="model_x_google_sheet_registr"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_selected()</field>
    </record>
</odoo>
