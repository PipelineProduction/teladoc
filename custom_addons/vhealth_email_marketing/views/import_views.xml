<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Eligibility Import List View -->
    <record id="view_eligibility_import_list" model="ir.ui.view">
        <field name="name">x.eligibility.import.list</field>
        <field name="model">x_eligibility_import</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_studio_import_status"/>
                <field name="x_studio_total_records"/>
                <field name="x_studio_processed_records"/>
                <field name="x_studio_created_contacts"/>
                <field name="x_studio_updated_contacts"/>
            </list>
        </field>
    </record>

    <!-- Eligibility Import Form View matching Odoo Online Studio layout -->
    <record id="view_eligibility_import_form" model="ir.ui.view">
        <field name="name">x.eligibility.import.form</field>
        <field name="model">x_eligibility_import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_import" type="object" string="Process Eligibility" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="x_studio_import_file" filename="x_studio_import_file_filename"/>
                        <field name="x_studio_import_file_filename" invisible="1"/>
                        <field name="x_studio_import_status"/>
                        <field name="x_studio_total_records"/>
                        <field name="x_studio_processed_records"/>
                        <field name="x_studio_created_contacts"/>
                        <field name="x_studio_updated_contacts"/>
                        <field name="x_studio_error_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eligibility_import" model="ir.actions.act_window">
        <field name="name">Eligibility Import</field>
        <field name="res_model">x_eligibility_import</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Weekly Registration Import List View -->
    <record id="view_weekly_registration_list" model="ir.ui.view">
        <field name="name">x.weekly.vhealth.regis.list</field>
        <field name="model">x_weekly_vhealth_regis</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_studio_import_status"/>
                <field name="x_studio_total_records"/>
                <field name="x_studio_processed_records"/>
                <field name="x_studio_created_contacts"/>
                <field name="x_studio_updated_contacts"/>
                <field name="x_studio_error_records"/>
            </list>
        </field>
    </record>

    <!-- Weekly Registration Import Form View matching Odoo Online Studio layout -->
    <record id="view_weekly_registration_form" model="ir.ui.view">
        <field name="name">x.weekly.vhealth.regis.form</field>
        <field name="model">x_weekly_vhealth_regis</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_import" type="object" string="Process Registration" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="x_name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="x_studio_import_file" filename="x_studio_import_file_filename"/>
                        <field name="x_studio_import_file_filename" invisible="1"/>
                        <field name="x_studio_import_status"/>
                        <field name="x_studio_total_records"/>
                        <field name="x_studio_processed_records"/>
                        <field name="x_studio_created_contacts"/>
                        <field name="x_studio_updated_contacts"/>
                        <field name="x_studio_error_records"/>
                        <field name="x_studio_import_result"/>
                        <field name="x_studio_google_sheet_payload"/>
                        <field name="x_studio_error_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_weekly_registration" model="ir.actions.act_window">
        <field name="name">Weekly vHealth Registration Import</field>
        <field name="res_model">x_weekly_vhealth_regis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
